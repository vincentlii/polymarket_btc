# Required. Obtain it from the current verified Gamma/market-rule metadata;
# do not copy a historical epoch name blindly.
# BTC_RULE_EPOCH=

# Required. Set this to the exact tested release commit used to build the image.
# BTC_CODE_REVISION=

# Required by the real-time Research Paper process and reused by the optional
# post-window causal Shadow profile. It is the in-container path of a locally
# validated Research Proxy artifact, for example:
# BTC_MODEL_DIRECTORY=/app/data/btc_short_horizon/models/<model-id>

# Virtual balance only. Research Paper never reads account credentials or sends orders.
BTC_PAPER_STARTING_BALANCE=1000

# Keep data and runtime output outside the image so a VPS replacement is a copy,
# not a rebuild or retraining exercise.
BTC_DATA_DIR=./runtime/data
BTC_OUTPUT_DIR=./runtime/output

# The dashboard remains loopback-only. View it through SSH forwarding or a
# private overlay network; do not expose it directly to the public internet.
BTC_DASHBOARD_BIND=127.0.0.1
BTC_DASHBOARD_PORT=8080
